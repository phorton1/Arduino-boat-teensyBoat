    (user_trace_width 1)
    (user_trace_width 2.2)
    (user_trace_width 3)
    (user_trace_width 3.5)
    (trace_clearance 0.2)
    (zone_clearance 0.508)
    (zone_45_only no)
    (trace_min 0.2)
    (via_size 0.8)
    (via_drill 0.4)
    (via_min_size 0.4)
    (via_min_drill 0.3)
