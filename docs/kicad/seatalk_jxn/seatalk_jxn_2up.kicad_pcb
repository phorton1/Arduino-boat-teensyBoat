(kicad_pcb (version 20171130) (host pcbnew "(5.1.6)-1")

  (general
    (thickness 1.6)
    (drawings 10)
    (tracks 38)
    (zones 0)
    (modules 10)
    (nets 4)
  )

  (page A4)
  (layers
